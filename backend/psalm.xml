<?xml version="1.0"?>
<psalm
    errorLevel="4"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedVariablesAndParams="true"
    cacheDirectory=".psalm-cache"
    threads="4"
>
    <projectFiles>
        <directory name="app" />
        <directory name="database" />
        <directory name="routes" />
        <directory name="tests" />
        <ignoreFiles>
            <!-- Third-party installer script, not our code -->
            <file name="composer-setup.php" />
            <!-- Polyfill for systems missing ext-intl; runtime-only -->
            <file name="app/Support/NumberFormatterPolyfill.php" />
            <!-- Laravel framework internals resolved via stubs -->
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>

    <issueHandlers>
        <!-- Controllers/models are called via routes — Psalm can't trace these -->
        <PossiblyUnusedMethod errorLevel="suppress" />

        <!-- Middleware/seeders/commands registered via config, not called directly -->
        <UnusedClass errorLevel="suppress" />

        <!-- Auth facade ->login() resolved via __call; interface doesn't declare it -->
        <UndefinedInterfaceMethod errorLevel="suppress" />

        <!-- Mockery fluent chains and Socialite facade in test doubles -->
        <UndefinedMagicMethod errorLevel="suppress" />
        <TooManyArguments errorLevel="suppress" />

        <!-- routes/console.php uses $this bound to the application closure -->
        <InvalidScope errorLevel="suppress" />

        <!-- Array key type variance on Eloquent base class overrides -->
        <NonInvariantDocblockPropertyType errorLevel="suppress" />

        <!-- Removed middleware classes referenced in Kernel/sanctum config -->
        <UndefinedClass errorLevel="suppress" />

        <!-- shell_exec in GenerateSslCertificate is intentional (dev-only command) -->
        <ForbiddenCode errorLevel="suppress" />

        <!-- Auth::user() returns Authenticatable interface, we assert User in context -->
        <PossiblyNullPropertyFetch errorLevel="suppress" />
        <PossiblyNullArgument errorLevel="suppress" />
        <NoInterfaceProperties errorLevel="suppress" />
        <ArgumentTypeCoercion errorLevel="suppress" />

        <!-- config() can return mixed; (string) cast is applied where needed -->
        <PossiblyInvalidCast errorLevel="suppress" />

        <!-- composer-setup.php issues (excluded above, but belt-and-suspenders) -->
        <PossiblyFalseArgument errorLevel="suppress" />
        <PossiblyFalseOperand errorLevel="suppress" />
        <NullArgument errorLevel="suppress" />
        <NullReference errorLevel="suppress" />

        <!-- Downgrade to info — not CI-blocking -->
        <MissingOverrideAttribute errorLevel="info" />
        <UnusedVariable errorLevel="info" />
        <UnusedClosureParam errorLevel="info" />
        <PossiblyUnusedParam errorLevel="info" />
    </issueHandlers>
</psalm>
