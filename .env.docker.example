# Optional overrides for docker-compose.yml.
# Copy to .env (next to docker-compose.yml) and adjust.

# Database credentials used by both the database and backend containers.
DB_DATABASE=vendora
DB_USERNAME=vendora
DB_PASSWORD=vendora
DB_ROOT_PASSWORD=root

# Email of your own account (e.g. the Google account you sign in with).
# It is created if missing and made an admin on every start.
ADMIN_EMAIL=

# To choose the password of the seeded admin@vendora.com, set ADMIN_PASSWORD in
# backend/.env (it is read from there). Left unset, a random one is generated on
# the first start and printed in the backend logs.

# AI support chat: local Ollama model by default. Set AI_SUPPORT_PROVIDER=openai
# (with OPENAI_API_KEY in backend/.env) or =none for plain FAQ matching.
AI_SUPPORT_PROVIDER=ollama
# Models are tried in order; the next one answers if the previous fails or times out.
AI_SUPPORT_MODELS=llama3.2:3b,llama3.2:1b

# Host port for MySQL (the frontend and backend ports are fixed at 4200 and 8000).
DB_HOST_PORT=3307
